# Crawl output and local state
data/raw/
data/radar.sqlite*
data/runs/
# G5 production dataset — local only, never committed (§14, §45)
data/production/
data/g5probe/

# G0 probe raw payloads — CNMV documents are NOT redistributed
# (see DATA-NOTICE.md); provenance metadata (*.meta.json) is committed
probe/raw/
probe/probe.sqlite*
probe/evidence/templates/*.pdf
probe/evidence/templates/*.txt
probe/evidence/windowed/*.html
probe/evidence/legal/*.html
probe/evidence/*.html

# G2 corpus — real CNMV PDFs not redistributed; manifest + parse
# reports (derived, no document content) stay tracked
corpus/dev/
corpus/holdout/
corpus/raw/
corpus/corpus.sqlite*
corpus/g3/

__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# local virtualenvs / editor state
.venv/
venv/
.env
.env.*
!.env.example

# python packaging artifacts
build/
*.egg-info/
nul

# packaging output
dist/
demo/*.sqlite-shm
demo/*.sqlite-wal
